from collections import deque

x, y, z = map(int, input().split())

q = deque([(0, 0, 0)])
visited = set()
found = False

while q:
    a, b, steps = q.popleft()

    if a == z or b == z:
        print(steps)
        found = True
        break

    if (a, b) in visited:
        continue

    visited.add((a, b))

    states = [
        (x, b), (a, y),
        (0, b), (a, 0),
        (max(0, a - (y - b)), min(y, a + b)),
        (min(x, a + b), max(0, b - (x - a)))
    ]

    for state in states:
        if state not in visited:
            q.append((*state, steps + 1))

if not found:
    print(-1)
